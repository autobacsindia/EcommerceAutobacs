# =============================================================================
# AUTOBACS INDIA - FRONTEND ENVIRONMENT VARIABLES TEMPLATE
# =============================================================================
# IMPORTANT:
# 1. NEVER commit a real .env.local with secrets to Git.
# 2. Copy this file to .env.local and fill in your DEV values.
# 3. For production, set these in the Vercel dashboard (scoped to the
#    "Production" environment). Do NOT keep prod values in any local file.
#
# DEV vs PROD: .env.local is the DEV tier (loaded by `npm run dev`) and should
# point at your LOCAL backend. The PROD tier lives in Vercel.
# Full dev↔prod variable matrix: ../../docs/ENVIRONMENTS.md
#
# NOTE: NEXT_PUBLIC_* vars are inlined into the client bundle at BUILD time and
# are publicly visible — never put secrets in a NEXT_PUBLIC_* var.
# =============================================================================

# ── Backend API ──────────────────────────────────────────────────────────────
# Proxy target for `/api/*` rewrites (next.config.ts → ${NEXT_PUBLIC_API_URL}/api/v1/*).
# DEV: your local backend.   PROD (Vercel): https://api.autobacsindia.com
NEXT_PUBLIC_API_URL=http://localhost:8080

# ── Site URL ─────────────────────────────────────────────────────────────────
# Build-time baked canonical site URL (src/lib/siteUrl.ts), used for SEO/canonicals.
# DEV: http://localhost:3000   PROD (Vercel): https://autobacsindia.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Meta (Facebook/Instagram) Pixel ──────────────────────────────────────────
# PUBLIC numeric pixel id (Events Manager). When set, layout.tsx loads the Pixel
# and PDP/cart/checkout fire ViewContent/AddToCart/Purchase (lib/metaPixel.ts).
# Leave UNSET on Preview/local so test events never hit the live dataset. Purchase
# is deduped with the backend Conversions API by eventID = order id. Build-time
# baked — redeploy after changing.
NEXT_PUBLIC_META_PIXEL_ID=

# ── Google Ads (gtag.js) ─────────────────────────────────────────────────────
# PUBLIC conversion id. When set, layout.tsx loads the Google tag and the funnel
# fires view_item / add_to_cart / begin_checkout / purchase (lib/googleAds*.ts).
# Leave UNSET on Preview/local so test purchases never pollute conversion data
# and Smart Bidding. Build-time baked — redeploy after changing.
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Conversion LABELS — the part after the "/" in a conversion action's send_to
# ("AW-11434499615/AbCdEfGh..."), copied from Google Ads → Goals → Conversions →
# <action> → Tag setup → Use Google tag.
# WITHOUT a label an event is sent to the account only: it fires, it shows in the
# dataLayer, it builds remarketing audiences — and the conversion action reports
# "no entries yet" forever, with no error anywhere. Set a label for every event
# you have created a conversion action for; leave the rest blank to keep them as
# remarketing-only signals.
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_VIEW_ITEM_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_ADD_TO_CART_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_BEGIN_CHECKOUT_LABEL=

# ── Legacy WordPress images ──────────────────────────────────────────────────
# Allowlists autobacsindia.com/wp-content + /cdn-cgi/image in next.config.ts.
# Keep "true" while the apex still serves WordPress assets.
# CUTOVER: after migrating logos/images to Cloudinary, set to "false" (or unset) —
# those URLs 404 once autobacsindia.com leaves WordPress. No code change needed.
NEXT_PUBLIC_ALLOW_WP_IMAGES=true

# ── JWT (server-side ONLY — NOT public) ──────────────────────────────────────
# The edge middleware (src/middleware.ts) verifies backend-signed JWTs with this.
# CROSS-APP COUPLING: must be IDENTICAL to the backend's JWT_SECRET WITHIN a tier,
# and DIFFERENT across tiers. Rotating it means updating BOTH apps in that tier.
JWT_SECRET=must_match_backend_JWT_SECRET_for_this_tier

# ── Razorpay (public key id only) ────────────────────────────────────────────
# Must match the backend's Razorpay key tier.
# DEV: rzp_test_*   PROD: rzp_test_* until cutover → rzp_live_* at go-live.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# ── Analytics (optional; leave blank to disable locally) ─────────────────────
# Use a DEV project/key locally so dev events don't pollute prod analytics.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_UI_HOST=
NEXT_PUBLIC_LOGROCKET_APP_ID=

# ── Google ───────────────────────────────────────────────────────────────────
# Site verification only matters in PROD; leave blank in dev.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── Careers application form (/careers) ──────────────────────────────────────
# Applications are in-house: the browser fetches signed upload params from our
# backend, uploads applicant videos/PDFs directly to Cloudinary (private), then
# POSTs the refs to /careers/applications. No Google Drive/Sheets/Apps Script
# (removed from the CSP connect-src in src/middleware.ts). No env var required.

# ── Build-time only ──────────────────────────────────────────────────────────
# Set ANALYZE=true to run the bundle analyzer during `next build`. Local only.
# ANALYZE=false

# ── Host-managed — DO NOT SET MANUALLY ───────────────────────────────────────
# Vercel injects these automatically; setting them by hand breaks detection.
# VERCEL, VERCEL_ENV, VERCEL_OIDC_TOKEN
