# =============================================================================
# AUTOBACS INDIA - ENVIRONMENT VARIABLES TEMPLATE
# =============================================================================
# IMPORTANT:
# 1. NEVER commit actual .env files with real secrets to Git
# 2. Copy this file to .env and fill in your values
# 3. For production, use Railway dashboard environment variables
#
# DEV vs PROD: This local .env is the DEV tier (loaded by `npm run dev`). It must
# point ONLY at dev resources (separate Atlas DB, separate Upstash Redis, etc.) so
# local development can never read/write production data. The PROD tier lives in the
# Railway dashboard. Full dev↔prod variable matrix: docs/ENVIRONMENTS.md
# =============================================================================

# ── MongoDB Configuration ────────────────────────────────────────────────────
# Get from MongoDB Atlas: https://cloud.mongodb.com/
# DEV: use a SEPARATE database (e.g. .../autobacs_dev) — never the prod DB.
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/autobacs?retryWrites=true&w=majority

# FOOTGUN: the server runtime reads MONGO_URI, but the one-off scripts in scripts/
# and the test setup read MONGODB_URI instead. Locally, set MONGODB_URI to the SAME
# dev DB so running a script can never silently hit prod. Do NOT set MONGODB_URI in
# the Railway prod dashboard unless a specific prod script truly needs it.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/autobacs_dev?retryWrites=true&w=majority

# TLS Configuration (MUST be true in production)
MONGO_TLS=true
MONGO_TLS_ALLOW_INVALID_CERTIFICATES=false
MONGO_TLS_ALLOW_INVALID_HOSTNAMES=false

# MongoDB Atlas API (for automatic IP whitelist management)
# Get from: MongoDB Atlas > Organization Settings > Access Manager > API Keys
MONGODB_ATLAS_PUBLIC_API_KEY=your_atlas_public_key
MONGODB_ATLAS_PRIVATE_API_KEY=your_atlas_private_key
MONGODB_ATLAS_PROJECT_ID=your_project_id
MONGODB_ATLAS_CLUSTER_NAME=Cluster0

# ── JWT Configuration ────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# MUST be at least 64 characters.
# CROSS-APP COUPLING: the frontend edge middleware (Front-end/web/src/middleware.ts)
# verifies backend-signed JWTs with its OWN JWT_SECRET. This value must be IDENTICAL
# to the frontend's JWT_SECRET WITHIN a tier, and DIFFERENT across tiers (use a fresh
# secret for dev vs prod). Rotating it means updating BOTH apps in that tier.
JWT_SECRET=your_jwt_secret_at_least_64_characters_long_use_crypto_random_bytes

# Token expiration
JWT_EXPIRE=30m
JWT_ADMIN_EXPIRE=15m
# Grace window (seconds) during which a just-rotated refresh token can be
# replayed by a concurrent/lagging request and still resolve to its successor
# instead of triggering reuse detection. Prevents spurious logouts when the
# browser fires the Edge-middleware refresh and in-flight API 401s at once.
REFRESH_ROTATION_GRACE_SECONDS=30

# ── Admin Account (seed/reset via: npm run seed:admin) ───────────────────────
# Consumed ONLY by create-admin-user.js to create or reset the admin account.
# Never hardcode the password in code. In production set these in the Railway
# dashboard, run the script once, then you may remove ADMIN_PASSWORD again.
# ADMIN_PASSWORD is REQUIRED (min 12 chars); the script aborts if it is missing.
ADMIN_EMAIL=info@autobacsindia.com
ADMIN_PASSWORD=use_a_strong_unique_password_min_12_chars
ADMIN_NAME=Admin

# ── Server Configuration ─────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Frontend URL for CORS ────────────────────────────────────────────────────
# Set FRONTEND_URL to your Cloudflare-proxied domain (NOT the raw Railway URL).
# The Railway .railway.app URL must also be included in FRONTEND_URLS so Railway
# health checks and internal routing continue to work during Cloudflare setup.
FRONTEND_URL=https://ecommerceautobacs-production-8ff6.up.railway.app
FRONTEND_URLS=https://autobacsindia.com,https://www.autobacsindia.com

# ── Cloudflare Configuration ──────────────────────────────────────────────────
# Set to true once Cloudflare proxy is live in front of this backend.
# Used to enforce CF-Connecting-IP as the authoritative real-IP source.
CLOUDFLARE_PROXY_ENABLED=true

# (WordPress/WooCommerce removed — data now lives entirely in MongoDB)

# ── Rate Limiting Configuration ──────────────────────────────────────────────
REGISTER_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_MAX=10
FAILED_LOGIN_RATE_LIMIT_MAX=5

# Shared secret proving a request came from our own Next.js server (SSR/ISR)
# rather than a browser. Server-side rendering leaves Vercel from a handful of
# egress IPs, so without this the whole frontend fleet shares ONE per-IP bucket
# (300/min) and starts 429-ing under load while real browsers are unaffected.
# Requests carrying this key get their own bucket with max × the multiplier below.
# Must match INTERNAL_API_KEY in the Vercel (frontend) environment.
# Generate with: openssl rand -hex 32     Minimum 24 chars, else it is ignored.
# UNSET = feature off, normal per-IP limits everywhere (safe default).
INTERNAL_API_KEY=
INTERNAL_RATE_LIMIT_MULTIPLIER=50

# ── MongoDB Connection Pool ──────────────────────────────────────────────────
# A throughput ceiling, not just a resource cap: max concurrent in-flight queries
# is maxPoolSize, so the app tops out at roughly (maxPoolSize / query round-trip)
# queries per second and everything beyond that queues while CPU stays idle.
# Raise this before adding CPU if requests are timing out under load.
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=5

# ── Elasticsearch (Optional) ─────────────────────────────────────────────────
# IMPORTANT: 
# - Set ELASTICSEARCH_ENABLED=false if not using Elasticsearch
# - NEVER use localhost in production - use cloud Elasticsearch service
# - Recommended: Elastic Cloud, AWS Elasticsearch, or self-hosted cluster
ELASTICSEARCH_ENABLED=false
ELASTICSEARCH_NODE=https://your-cluster.us-east-1.aws.elastic-cloud.com:9200
# Index name. MUST differ per tier if two tiers share one ES deployment
# (e.g. staging on `develop` → products_staging) so a test reindex can't clobber
# the prod `products` index. Defaults to `products` when unset.
ELASTICSEARCH_INDEX=products
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=your_elasticsearch_password
ELASTICSEARCH_RETRY_TIMEOUT=5000
ELASTICSEARCH_LOG_LEVEL=warn

# ── Inventory Settings ───────────────────────────────────────────────────────
STOCK_RESERVATION_TIMEOUT=24
LOW_STOCK_THRESHOLD=5
ENABLE_SPLIT_SHIPMENTS=false
STOCK_SYNC_FREQUENCY=3600

# ── Email Notifications (Postmark) ───────────────────────────────────────────
# Server API token: Postmark → Servers → <your server> → API Tokens
POSTMARK_SERVER_TOKEN=your_postmark_server_token
# From address MUST be a verified Sender Signature or a confirmed domain in Postmark,
# otherwise sends are rejected.
POSTMARK_FROM_EMAIL=noreply@yourdomain.com
POSTMARK_FROM_NAME=Autobacs
# Message stream for transactional mail (default). Marketing/broadcast should use a
# separate stream (e.g. "broadcast") so its reputation can't affect transactional.
POSTMARK_MESSAGE_STREAM=outbound
# Optional friendlier sender for the welcome email (registration). Must be on the same
# verified/confirmed domain in Postmark. Falls back to POSTMARK_FROM_EMAIL if unset.
POSTMARK_WELCOME_FROM_EMAIL=hi@autobacsindia.com
POSTMARK_WELCOME_FROM_NAME=Autobacs India

# Delay (ms) before the post-delivery review-request email fires, measured from the
# moment an order is marked delivered. Defaults to 24h. Shrink it for QA/testing.
REVIEW_REQUEST_DELAY_MS=86400000

# ── Sales CRM / Leads ─────────────────────────────────────────────────────────
# Reconciliation sweeps that lead-ify time-defined states (see services/leadSweepService.js).
# An order left "pending" longer than this (minutes) counts as an abandoned checkout.
LEAD_ABANDONED_AFTER_MIN=60
# A registered (non-guest) account with no paid order older than this (days) becomes a dormant lead.
LEAD_DORMANCY_DAYS=30
# An open lead untouched longer than this (days) gets flagged for follow-up.
LEAD_FOLLOWUP_SLA_DAYS=3
# Max docs processed per sweep run (idempotent — the next run continues).
LEAD_SWEEP_BATCH=500
# Cron schedules (Asia/Kolkata). Frequent = abandoned + stale; daily = dormant users.
LEAD_SWEEP_CRON=15 * * * *
LEAD_DORMANT_SWEEP_CRON=30 3 * * *

# ── Company / Invoice details (printed on the invoice PDF) ────────────────────
# Env-driven so legal entity details are never hardcoded. Set real values in
# Railway. Missing fields are simply omitted from the invoice (no crash).
COMPANY_NAME=Autobacs India
COMPANY_GSTIN=
COMPANY_ADDRESS=
COMPANY_CITY=
COMPANY_STATE=
COMPANY_PINCODE=
COMPANY_PHONE=
COMPANY_EMAIL=support@autobacsindia.com
# Invoice numbers are sequential (the "invoice" Counter). Seed the starting point
# with scripts/seed-invoice-counter.js <lastIssuedNumber>. These optionally dress
# up the DISPLAYED number without changing the counter: prefix + zero-pad
# (e.g. PREFIX="INV-", PAD=6 → "INV-000059"). Blank/0 = plain integer ("59").
COMPANY_INVOICE_PREFIX=
COMPANY_INVOICE_PAD=
# Logo shown on the invoice PDF. Leave blank to use the storefront navbar's
# Roavion logo (default in config/company.js). Must be a PNG/JPEG URL — Cloudinary
# f_auto URLs are auto-normalised to f_png (pdfkit can't embed webp/avif).
COMPANY_LOGO_URL=
# Optional: also archive each invoice PDF to Cloudinary (resource_type 'raw').
# The PDF is always attached to the email regardless; this only enables re-download.
INVOICE_STORE_CLOUDINARY=false
INVOICE_CLOUDINARY_FOLDER=invoices

# ── Meta (Facebook/Instagram) catalogue feed ─────────────────────────────────
# Served at /api/v1/feeds/meta-catalog.xml for Meta Commerce Manager to pull on a
# schedule. Product links use FRONTEND_URL (the storefront domain), so make sure
# that points at the customer-facing site, not the raw Railway URL, at cutover.
# In-process cache TTL (seconds) — Meta pulls at most hourly, so 1800 is plenty.
META_FEED_CACHE_SECONDS=1800
# Fallback brand for products with no brand set (Meta requires a brand). Defaults
# to COMPANY_NAME when unset.
META_FEED_DEFAULT_BRAND=Autobacs India

# ── Google Merchant Center feed ──────────────────────────────────────────────
# Served at /api/v1/feeds/google-merchant.xml for Merchant Center to fetch on a
# schedule (Products → Data sources → Add product source → Scheduled fetch).
# Offer ids are the SAME ids as the Meta feed on purpose (utils/googleCatalogId.js),
# so an order line item's stored catalogue id works for both channels.
# In-process cache TTL (seconds). Merchant Center fetches at most daily.
GOOGLE_FEED_CACHE_SECONDS=1800
# Fallback brand for products with no brand set (Google requires brand or a
# unique identifier). Falls back to META_FEED_DEFAULT_BRAND, then COMPANY_NAME.
GOOGLE_FEED_DEFAULT_BRAND=Autobacs India
# Blanket google_product_category for the whole catalogue — every item we sell is
# an automotive part/accessory. Must be a valid value from Google's product
# taxonomy; leave unset to use the same default in code.
GOOGLE_FEED_PRODUCT_CATEGORY=Vehicles & Parts > Vehicle Parts & Accessories
# Canonical storefront origin for GOOGLE feed product links, WITHOUT the trailing
# slash. Set this when the customer-facing origin differs from FRONTEND_URL (ours
# redirects apex → www): Merchant Center matches landing pages against the claimed
# website, and every redirect hop is a crawl/click cost. Falls back to FRONTEND_URL.
# The Meta feed deliberately stays on FRONTEND_URL — its catalogue is live and
# verified, and changing link origins there buys nothing.
FEED_SITE_URL=https://www.autobacsindia.com

# ── Meta Conversions API (server-side Purchase) ──────────────────────────────
# Server-side Purchase events (services/metaCapiService.js), deduped with the
# client Pixel by event_id = order id. All SECRETS — set in Railway only; unset =
# silently disabled (no events sent). META_PIXEL_ID is the SAME numeric id as the
# frontend's NEXT_PUBLIC_META_PIXEL_ID. Get the access token from Events Manager →
# Settings → Conversions API → generate a system-user token.
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# Optional: while testing, paste the code from Events Manager → Test events so
# events land in that tab instead of live. REMOVE for production traffic.
META_CAPI_TEST_EVENT_CODE=
# Optional: pin the Graph API version (defaults to a known-good version in code).
META_GRAPH_VERSION=

# ── SMS Notifications (Twilio) ───────────────────────────────────────────────
# Get from: https://console.twilio.com/
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+91XXXXXXXXXX

# ── Notification Settings ────────────────────────────────────────────────────
NOTIFICATION_RETRY_ATTEMPTS=3
NOTIFICATION_RETRY_DELAY=1000
ENABLE_EMAIL_NOTIFICATIONS=true
# Reroute ALL outbound email to one inbox, ignoring the real recipient. Leave UNSET in
# production. Set it in any environment running against a restored copy of the prod
# database, where order/user records hold real customer addresses. Subject is prefixed
# with the original recipient. A set-but-invalid value blocks sending (fails closed).
# EMAIL_REDIRECT_TO=you@example.com
# Internal inbox(es) that receive admin alerts (new customer reviews, consultation
# requests, paid orders, and customer order cancellations). Comma-separate to notify
# several addresses. Optional — falls back to the singular ADMIN_NOTIFICATION_EMAIL,
# then COMPANY_EMAIL (support@autobacsindia.com).
ADMIN_NOTIFICATION_EMAILS=support@autobacsindia.com
ENABLE_SMS_NOTIFICATIONS=false

# ── Support ticketing ────────────────────────────────────────────────────────
# Full setup steps: docs/RUNBOOK-support-inbox.md
#
# The public support address. Customers see it as the sender and reply to it;
# outbound support mail is plus-addressed from it (support+t.ABI-1042.<hmac>@…),
# so the domain MUST deliver plus-addressed mail to the same inbox. Google
# Workspace does this by default.
SUPPORT_EMAIL=support@autobacsindia.com
SUPPORT_FROM_NAME=Autobacs India Support

# Dedicated Postmark message stream for support conversations. Isolating it means
# a spam complaint on support mail cannot degrade delivery of order confirmations
# and invoices. Create it in Postmark first; falls back to POSTMARK_MESSAGE_STREAM.
POSTMARK_SUPPORT_STREAM=support

# HMAC secret for the per-ticket reply token. REQUIRED in production.
# Deliberately NOT JWT_SECRET: this value is embedded in plaintext in every
# outbound email and travels through third-party mail servers, so it must be
# rotatable without invalidating every user session. Generate with:
#   openssl rand -hex 32
SUPPORT_REPLY_SECRET=

# Shared secret for the Postmark inbound webhook. REQUIRED — the handler fails
# CLOSED without it, because an unauthenticated endpoint that writes to the
# database must never be exposed. Give it to Postmark as HTTP Basic credentials
# in the webhook URL: https://any:<secret>@api.autobacsindia.com/api/v1/support/inbound
POSTMARK_INBOUND_SECRET=

# Postmark's inbound source IPs (comma-separated). Leave UNSET to use the built-in
# list. Set to an empty string to disable the IP check entirely (the URL secret
# still applies) — useful if Postmark changes ranges and mail starts 403ing.
# POSTMARK_INBOUND_IPS=

# Full-day support closures as IST YYYY-MM-DD, comma-separated. The SLA clock
# does not run on these, so a ticket arriving the evening before a holiday is not
# already breached when the team returns. Update here, no deploy needed.
# SUPPORT_HOLIDAYS=2026-08-15,2026-10-20

# Hours of total inbound silence (during business hours only) before the pipeline
# liveness alert fires. A broken inbound webhook is otherwise SILENT.
SUPPORT_SILENCE_ALERT_HOURS=4

# Support health sweep: inbound liveness + SLA breach + stuck-email requeue.
SUPPORT_HEALTH_CRON=*/15 * * * *

# ── Razorpay Payment Gateway ─────────────────────────────────────────────────
# IMPORTANT: Use LIVE keys for production (rzp_live_*)
# Get from: https://dashboard.razorpay.com/app/keys
# TEST keys: rzp_test_xxxxx
# LIVE keys: rzp_live_xxxxx
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# CRITICAL: Webhook secret for HMAC-SHA256 signature verification.
# Get from: Razorpay Dashboard → Account & Settings → Webhooks → (your webhook) → Secret
# Without this, ALL incoming webhooks will be rejected with HTTP 500.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:8080/api/v1/auth/google/callback

# ── Facebook OAuth ───────────────────────────────────────────────────────────
# Get from: https://developers.facebook.com/apps/
FACEBOOK_CLIENT_ID=your_facebook_app_id
FACEBOOK_CLIENT_SECRET=your_facebook_app_secret

# ── Cloudinary (Image Storage) ───────────────────────────────────────────────
# Get from: https://cloudinary.com/console
# Also stores careers application files (videos/PDFs) as PRIVATE (authenticated)
# assets under autobacs/careers/* — admins view them via short signed URLs.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Redis (Caching & Sessions) ───────────────────────────────────────────────
# Get from: Redis provider (Upstash, Railway, etc.)
REDIS_URL=redis://:your_redis_password@your_redis_host:your_redis_port

# ── Sentry (Error Monitoring) ────────────────────────────────────────────────
# Get from: https://sentry.io/ → Project Settings → Client Keys (DSN)
SENTRY_DSN=https://your_sentry_dsn@sentry.io/your_project_id
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
# Set to your git tag / package version for release tracking in Sentry
# SENTRY_RELEASE=1.0.0

# ── Alerting (P1 Incident Notifications) ─────────────────────────────────────
# Slack: Settings → Apps → Incoming Webhooks → Add to Slack
# All 5xx errors in production fire a deduplicated Slack alert (max once per 5 min per error type)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...

# ── Cache Configuration (Optional) ───────────────────────────────────────────
CACHE_VERSION=v1
CACHE_WARMUP_ENABLED=false
REGION_ID=default

# ── Railway Deployment (Auto-set by Railway) ─────────────────────────────────
# DO NOT SET MANUALLY - Railway sets these automatically
# RAILWAY_PUBLIC_URL=
# RAILWAY_DEPLOYMENT_ID=
