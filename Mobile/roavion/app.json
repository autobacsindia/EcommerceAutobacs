{
  "expo": {
    "name": "Autobacs",
    "slug": "roavion",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "roavion",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.roavion.shop"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#080808"
      },
      "package": "com.roavion.shop"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#080808"
        }
      ],
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Autobacs needs your videos so you can post a reel.",
          "cameraPermission": "Autobacs uses the camera so you can record a reel.",
          "microphonePermission": "Autobacs records sound with your reel."
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://api.autobacsindia.com/api/v1",
      "siteUrl": "https://www.autobacsindia.com",
      "supportPhone": "+919895257905",
      "supportWhatsapp": "+919895257905"
    }
  }
}
