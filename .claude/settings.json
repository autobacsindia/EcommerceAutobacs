{
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git fetch *)",
      "Bash(git fetch)",
      "Bash(git rebase *)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr view)",
      "Bash(gh pr checks *)",
      "Bash(gh pr checks)",
      "Bash(gh pr merge *)"
    ],
    "deny": [
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *refs/heads/main*)",
      "Bash(git push *--no-verify*)",
      "Bash(git commit *--no-verify*)",
      "Bash(gh pr merge *--admin*)"
    ]
  }
}
